# Database — DIGANTI SEBELUM PRODUCTION
# DB_NAME/DB_USER/DB_PASSWORD ditanam setup.sh ke raddb (mods-available/sql)
# lalu diverifikasi — ganti di sini, lalu jalankan ULANG setup.sh.
DB_ROOT_PASSWORD=rootpass_ganti
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=radiuspass_ganti

# Bootstrap API key (scope=admin). Generate random 32+ char.
# Contoh: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# Basic Auth (scope=admin) — INI yang dipakai ERP.
#
# JANGAN diisi tangan di appliance mitra: radius-erp-enroll yang menanamnya,
# dari nilai yang DIBANGKITKAN ERP. Kalau diisi sendiri di sini, operator harus
# membaca dua nilai dari konsol lalu mengetiknya ke form ERP — perpindahan
# manual kedua, arah berlawanan, dan tak terverifikasi sampai sinkron pertama
# gagal 401.
#
# Keduanya kosong = Basic auth MATI (middleware.APIKey). Di appliance mitra
# API_KEY juga ditulis KOSONG oleh appliance/firstboot.sh (bukan placeholder di
# atas, yang hanya untuk pemakaian manual/lab), sehingga appliance yang belum
# di-enroll menolak SEMUA panggilan API — gagal-tertutup, bukan jendela terbuka.
#
# `SWAGGER_USERNAME`/`SWAGGER_PASSWORD` diterima sebagai alias (dipakai
# radius-manager-api untuk instance NOC); lihat config.getenvAlias.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Versi image FreeRADIUS. SATU sumber untuk docker-compose.yml DAN setup.sh —
# raddb/ disalin dari image ini, jadi dua tempat yang menyebut versi berbeda
# berarti server berjalan dengan config yang bukan miliknya.
FR_TAG=3.2.10

# Port TERBIT REST API di host. Container selalu 8000.
#
# Di appliance mitra nilai ini DITANAM radius-erp-enroll dari port dst-nat yang
# dialokasikan ERP (15000-19999) — jangan diisi tangan. Di lab biarkan 8000.
# JANGAN dikosongkan: compose membaca `${API_PORT:-8000}`, dan nilai KOSONG
# bukan "tak diisi" melainkan port host acak.
API_PORT=8000

# Rate limit (per API key kalau auth sukses, per IP kalau tidak)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# Webhook background poller (interval polling DB untuk event session/auth)
WEBHOOK_POLL_SECONDS=5

# Pemeriksa kesehatan FreeRADIUS — GET /api/v1/radius/health.
#
# ERP memanggilnya SEBELUM mengalihkan router ke server ini. API yang sehat
# tidak berarti FreeRADIUS sehat (Pali, 17 Nov 2026: FreeRADIUS restart terus,
# API menjawab, router dialihkan, semua login "radius timeout").
#
# SECRET: biarkan KOSONG — setup.sh membangkitkannya (acak 256-bit) DAN
# menanamnya ke raddb/sites-available/netovas-health. Diisi tangan? Jalankan
# ulang setup.sh supaya raddb ikut, lalu `docker compose restart freeradius`.
# Kosong di api = endpoint menjawab 501 (belum dikonfigurasi), bukan "sehat".
RADIUS_HEALTH_SECRET=
# ADDR: socket INTERNAL 18190 di container freeradius (tak diterbitkan ke
# host). Jangan diganti ke 1812 — client pemeriksa hanya berlaku di 18190.
RADIUS_HEALTH_ADDR=freeradius:18190

# autoclearzombie.sh: sesi radacct tanpa Interim-Update selama N menit ditutup.
# Harus > 2x interim-update router (skrip NAS ERP = 5m → 10; router 10m → 25).
ZOMBIE_THRESHOLD_MINUTES=10

# autobackups3.sh (stack Docker): tujuan unggah rclone. Remote dibuat dengan
# `rclone config`. BACKUP_PATH kosong = radiusdb/<DB_NAME> supaya server yang
# berbagi bucket tidak saling menimpa.
BACKUP_REMOTE=s3
BACKUP_BUCKET=backup-db
BACKUP_PATH=
