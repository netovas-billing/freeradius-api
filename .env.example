# Database — DIGANTI SEBELUM PRODUCTION
DB_ROOT_PASSWORD=rootpass_ganti
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=radiuspass_ganti

# Bootstrap API key (scope=admin). Generate random 32+ char.
# Contoh: openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# Basic Auth (scope=admin) — INI yang dipakai ERP.
#
# JANGAN diisi tangan di appliance mitra: radius-erp-enroll yang menanamnya,
# dari nilai yang DIBANGKITKAN ERP. Kalau diisi sendiri di sini, operator harus
# membaca dua nilai dari konsol lalu mengetiknya ke form ERP — perpindahan
# manual kedua, arah berlawanan, dan tak terverifikasi sampai sinkron pertama
# gagal 401.
#
# Keduanya kosong = Basic auth MATI (middleware.APIKey). Di appliance mitra
# API_KEY juga ditulis KOSONG oleh appliance/firstboot.sh (bukan placeholder di
# atas, yang hanya untuk pemakaian manual/lab), sehingga appliance yang belum
# di-enroll menolak SEMUA panggilan API — gagal-tertutup, bukan jendela terbuka.
#
# `SWAGGER_USERNAME`/`SWAGGER_PASSWORD` diterima sebagai alias (dipakai
# radius-manager-api untuk instance NOC); lihat config.getenvAlias.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Versi image FreeRADIUS. SATU sumber untuk docker-compose.yml DAN setup.sh —
# raddb/ disalin dari image ini, jadi dua tempat yang menyebut versi berbeda
# berarti server berjalan dengan config yang bukan miliknya.
FR_TAG=3.2.10

# Rate limit (per API key kalau auth sukses, per IP kalau tidak)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_SECONDS=60

# Webhook background poller (interval polling DB untuk event session/auth)
WEBHOOK_POLL_SECONDS=5

# Cermin Alpine pengganti dl-cdn.alpinelinux.org saat membangun image api.
# Kosong = pakai dl-cdn. Diisi kalau `apk add` menggantung dengan
# "Permission denied" meski `docker pull` jalan — dua jalur jaringan yang
# berbeda (daemon vs build). Lihat appliance/README.md.
APK_MIRROR=
