#!/usr/bin/env bash
# radius-vpn-connect <host-concentrator> <username-ppp> <sandi-ppp> <pool-nas>
#
# Menyambungkan appliance ini ke VPN concentrator lewat L2TP. Ditulis sekali
# oleh NOC dan dipanggil dengan empat argumen; TIDAK ada yang menyunting
# xl2tpd.conf / options / ip-up.d tangan. Jalur manual itu sudah terbukti penuh
# kegagalan diam, dan tiap jebakannya ditandai di bawah.
#
# Biasanya tidak dipanggil langsung: radius-erp-enroll memanggilnya sesudah
# menanam kredensial REST.
set -euo pipefail

[ $# -eq 4 ] || {
  echo "pakai: $0 <host-concentrator> <username-ppp> <sandi-ppp> <pool-nas-cidr>" >&2
  exit 2
}
HOST="$1"; USER_PPP="$2"; PASS_PPP="$3"; POOL_NAS="$4"

# Skrip ini menulis /etc/xl2tpd, /etc/ppp, dan /etc/ppp/ip-up.d. Tanpa
# pemeriksaan ini kegagalannya berupa "Permission denied" pada berkas pertama
# yang ditulis — menyesatkan, karena yang kurang bukan berkasnya tapi hak akses.
[ "$(id -u)" = "0" ] || { echo "jalankan sebagai root (sudo)" >&2; exit 1; }

command -v xl2tpd >/dev/null || {
  echo "xl2tpd belum terpasang (NOC: apt install xl2tpd)" >&2
  exit 1
}

# JEBAKAN 1 — xl2tpd.conf memakai ';' untuk komentar, BUKAN '#'. Baris ber-'#'
# dibaca sebagai setelan tak dikenal: xl2tpd tetap start, tunnel tak pernah
# naik, dan tak ada galat yang menyebut barisnya.
cat >/etc/xl2tpd/xl2tpd.conf <<EOF
; dihasilkan radius-vpn-connect — JANGAN sunting tangan
[global]
access control = no

[lac concentrator]
lns = ${HOST}
require chap = yes
refuse pap = yes
require authentication = yes
pppoptfile = /etc/ppp/options.l2tpd.client
length bit = yes
; JEBAKAN 6 — inilah yang membuat tunnel naik lagi SENDIRI sesudah appliance
; reboot. Tanpa `autodial`, xl2tpd start, membaca LAC ini, membuat FIFO
; kontrolnya, lalu DIAM: LAC cuma definisi, tak ada panggilan yang dibuka.
; Satu-satunya pendial adalah `c concentrator` di bawah — dan itu dijalankan
; manusia, sekali, saat enroll. Jadi sebelum baris ini ada, satu kedipan
; listrik di tempat mitra = RADIUS mati sampai ada yang datang mengetik ulang.
;
; `redial` mengurus sesi yang PUTUS sesudah sempat naik. `max redials` ditulis
; eksplisit dan BESAR, bukan 0: man page tidak menyebut nilai bawaannya, dan
; pembacaan "0 = tak terhingga" adalah tebakan yang justru bisa berarti
; kebalikannya (tak pernah redial). Appliance ini harus menyusul sendiri saat
; concentrator kembali hidup, berapa pun lamanya.
autodial = yes
redial = yes
redial timeout = 10
max redials = 32767
EOF

cat >/etc/ppp/options.l2tpd.client <<EOF
ipcp-accept-local
ipcp-accept-remote
refuse-eap
require-mschap-v2
noccp
noauth
mtu 1410
mru 1410
noipdefault
usepeerdns
connect-delay 5000
name ${USER_PPP}
# persist + maxfail 0 menjaga pppd yang SEDANG HIDUP tetap mencoba saat
# negosiasi gagal. Keduanya TIDAK memulihkan apa pun sesudah reboot, dan dulu
# komentar di sini mengklaim sebaliknya: pppd bukan proses mandiri, ia anak
# xl2tpd di atas pty, dijalankan per-call dan di-TERM saat call dibongkar.
# Yang memulihkan sesudah reboot adalah `autodial` di xl2tpd.conf (di atas),
# dan `radius-vpn-watchdog` sebagai jaring terakhir.
persist
maxfail 0
holdoff 10
EOF
chmod 600 /etc/ppp/options.l2tpd.client

# Kredensial di chap-secrets, bukan di options: options dibaca semua orang.
#
# Berkas ini DITULIS ULANG, tidak ditambahi: appliance hanya punya satu
# sambungan PPP, dan baris lama dengan username yang sama akan menang tanpa
# terlihat di mana pun. Tapi di mesin yang BUKAN appliance murni — mis. lab
# yang dipakai bekerja — berkas yang sama bisa memuat kredensial PPP lain.
# Disalin sekali sebelum ditimpa; penandanya di baris pertama supaya jalan
# kedua tidak menimpa salinan itu dengan berkas hasil skrip ini sendiri.
umask 077
if [ -s /etc/ppp/chap-secrets ] &&
   ! grep -q 'dihasilkan radius-vpn-connect' /etc/ppp/chap-secrets &&
   [ ! -e /etc/ppp/chap-secrets.sebelum-radius ]; then
  cp -a /etc/ppp/chap-secrets /etc/ppp/chap-secrets.sebelum-radius
  echo "catatan: chap-secrets lama disalin ke /etc/ppp/chap-secrets.sebelum-radius"
fi
cat >/etc/ppp/chap-secrets <<EOF
# dihasilkan radius-vpn-connect — JANGAN sunting tangan
# client	server	secret	IP
"${USER_PPP}"	*	"${PASS_PPP}"	*
EOF
# EKSPLISIT, bukan mengandalkan umask di atas: redirect ke berkas yang SUDAH
# ADA mempertahankan mode lamanya, jadi umask tak berlaku sama sekali di jalur
# yang justru paling sering terjadi. Diuji: tanpa baris ini, chap-secrets yang
# tadinya 644 tetap 644 — sandi PPP terbaca semua pengguna mesin.
chmod 600 /etc/ppp/chap-secrets

# JEBAKAN 2 — berkas di /etc/ppp/ip-up.d/ HANYA dijalankan kalau namanya
# berakhiran .sh DAN bisa dieksekusi. Tanpa keduanya ia diam saja.
#
# JEBAKAN 3 — RUTE BALIK KE POOL NAS. Ini yang paling halus dari semuanya.
# Profile PPP memberi appliance local-address = GATEWAY POOL NAS (mis.
# 172.31.199.1), sementara alamat appliance sendiri ada di pool MANAJEMEN (mis.
# 172.16.0.9) — dua /24 yang berbeda. pppd hanya memasang rute host /32 ke
# peer-nya, jadi balasan auth ke IP tunnel NAS TIDAK cocok rute mana pun di
# ppp0: ia jatuh ke default route appliance, keluar ke LAN mitra, dan hilang.
# FreeRADIUS menerima permintaan, menjawabnya, dan jawabannya tak pernah
# sampai — di router pelanggan yang terlihat cuma "radius timeout".
#
# Ini BERPASANGAN dengan pengecualian masquerade di concentrator. Sebelum
# pengecualian itu ada, paket NAS di-masquerade jadi gateway pool — yang justru
# PERSIS alamat peer appliance — sehingga rute balik kebetulan bekerja
# sementara identitas NAS-nya rusak. Menutup satu sisi saja hanya memindahkan
# gejalanya. Kalau salah satu sisi kelak diubah, ubah DUA-DUANYA.
cat >/etc/ppp/ip-up.d/50-radius-route.sh <<EOF
#!/bin/sh
# dihasilkan radius-vpn-connect — JANGAN sunting tangan
# \$1 = nama interface ppp yang baru naik
# replace (bukan add): idempoten, jadi tunnel yang naik-turun berkali-kali
# tidak menumpuk rute maupun gagal dengan "File exists".
ip route replace ${POOL_NAS} dev "\$1"
echo "\$(date -Is) ppp up: iface=\$1 local=\$4 remote=\$5 rute=${POOL_NAS}" \\
  >>/var/log/radius-vpn.log
EOF
chmod +x /etc/ppp/ip-up.d/50-radius-route.sh

# JEBAKAN 4 — `enable --now` TIDAK memuat ulang config pada daemon yang SUDAH
# jalan. Paket xl2tpd Debian menyalakan servicenya saat dipasang, yaitu dengan
# xl2tpd.conf BAWAAN yang tak punya `[lac concentrator]` sama sekali. Jadi
# `--now` pada unit yang sudah aktif tak melakukan apa pun, dan perintah
# `c concentrator` di bawah menyebut LAC yang tidak dikenal daemon yang sedang
# berjalan — diterima tanpa galat, tanpa ada yang mendial. Gejalanya persis
# "tunnel tidak naik dalam 60 detik" tanpa sebab yang kelihatan.
# RESTART, bukan --now.
systemctl enable xl2tpd >/dev/null 2>&1 || true
systemctl restart xl2tpd

# JEBAKAN 5 — l2tp-control adalah FIFO yang dibuat xl2tpd saat ia START. Kalau
# daemonnya mati (atau FIFO-nya belum ada), `echo > …` justru MEMBUAT berkas
# biasa: exit 0, tak ada galat, dan perintah dial-nya hilang ke dalam berkas
# yang tak dibaca siapa pun. Karena itu keberadaannya ditunggu DAN diperiksa
# harus FIFO (-p), bukan sekadar ada.
CONTROL=""
for _ in $(seq 1 10); do
  for kandidat in /var/run/xl2tpd/l2tp-control /run/xl2tpd/l2tp-control \
                  /var/run/xl2tpd-control; do
    [ -p "$kandidat" ] && CONTROL="$kandidat" && break
  done
  [ -n "$CONTROL" ] && break
  sleep 1
done
[ -n "$CONTROL" ] || {
  echo "GAGAL: xl2tpd tidak membuat socket kontrolnya — daemonnya tidak jalan." >&2
  echo "--- status:" >&2
  systemctl status xl2tpd --no-pager -n 20 2>&1 | sed 's/^/    /' >&2 ||
    service xl2tpd status 2>&1 | sed 's/^/    /' >&2 || true
  exit 1
}

# Sesudah `autodial = yes`, restart di atas SUDAH mendial. Dial manual di sini
# hanya cadangan — dikirim kalau 12 detik berlalu tanpa sesi. Mengirimnya tanpa
# memeriksa berarti membuka panggilan KEDUA ke LAC yang sama: dua sesi PPP,
# dua alamat, dan concentrator memegang sesi basi yang tak ada yang menutup.
echo -n "menunggu tunnel naik"
ada_sesi() { ip -4 -o addr show 2>/dev/null | grep -qE ' (ppp|l2tp)'; }
for _ in $(seq 1 6); do
  ada_sesi && break
  echo -n "."
  sleep 2
done
ada_sesi || echo "c concentrator" >"$CONTROL"
for _ in $(seq 1 30); do
  if ip -4 -o addr show 2>/dev/null | grep -qE ' (ppp|l2tp)'; then
    echo
    ip -4 -o addr show | grep -E ' (ppp|l2tp)'
    echo "OK — tunnel naik."
    echo "Cocokkan alamat di atas dengan 'Alamat di dalam tunnel' di layar ERP."
    exit 0
  fi
  echo -n "."
  sleep 2
done

echo
echo "GAGAL: tunnel tidak naik dalam ~70 detik." >&2
echo >&2
# Log-nya DICETAK, tidak cuma disuruh dibaca: yang menjalankan ini adalah orang
# yang baru memasang appliance, dan "jalankan journalctl" berarti sesi
# troubleshoot kedua yang bisa dihindari.
echo "--- 25 baris terakhir log xl2tpd/pppd:" >&2
if command -v journalctl >/dev/null; then
  journalctl -u xl2tpd -n 25 --no-pager 2>&1 | sed 's/^/    /' >&2
else
  tail -n 25 /var/log/syslog 2>/dev/null | grep -iE 'xl2tpd|pppd' |
    sed 's/^/    /' >&2 || true
fi
cat >&2 <<PETUNJUK

Yang biasanya jadi sebab, berurutan:
  1. "Unable to find a tunnel definition" → daemonnya memegang config lama.
     Ulangi perintah ini; ia me-restart xl2tpd, bukan sekadar start.
  2. "Maximum retries exceeded"/sunyi → UDP 1701 ke ${HOST} tak sampai.
     Uji: nc -zvu ${HOST} 1701   (dan periksa NAT/firewall mitra)
  3. "Authentication failed"/CHAP → user/sandi PPP tidak cocok dengan
     /ppp secret di concentrator. Jangan ditebak: daftarkan ulang dari ERP,
     sandinya hanya tampil sekali dan tak bisa dibaca lagi.
PETUNJUK
exit 1
