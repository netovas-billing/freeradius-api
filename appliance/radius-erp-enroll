#!/usr/bin/env bash
# radius-erp-enroll <host-conc> <user-ppp> <sandi-ppp> <pool-nas> <api-user> <api-key> <port-api>
#
# SATU perintah yang menyambungkan appliance ini ke ERP. Inilah satu-satunya
# hal yang dijalankan mitra, dan satu-satunya yang berpindah manual dalam
# seluruh pemasangan: satu baris, satu arah, dari layar ERP ke konsol ini.
#
# KENAPA KREDENSIALNYA DATANG DARI ERP, bukan dibangkitkan di sini.
# Kalau appliance membangkitkannya sendiri, operator harus MEMBACA dua nilai
# dari layar konsol Proxmox lalu mengetiknya ke form ERP — perpindahan manual
# kedua, arah berlawanan, rawan salah ketik, dan tak bisa diverifikasi sampai
# sinkron pertama gagal dengan 401. ERP sudah membangkitkan sandi PPP; dua
# nilai ini menumpang di baris yang sama.
#
# Sebelum enroll, appliance menolak SEMUA panggilan API: API_KEY kosong
# mematikan X-API-Key (config.muatAPIKey gagal-tertutup) dan BASIC_AUTH_*
# kosong mematikan Basic (middleware.APIKey). Jadi tidak ada jendela terbuka
# antara boot pertama dan enroll.
set -euo pipefail

[ $# -eq 7 ] || {
  cat >&2 <<'USAGE'
pakai: radius-erp-enroll <host-conc> <user-ppp> <sandi-ppp> <pool-nas> <api-user> <api-key> <port-api>

Jangan dirangkai tangan. Salin barisnya UTUH dari layar ERP
(Infrastruktur > RADIUS > Tambah, panel "Sambungkan appliance").
Jumlah argumen yang bukan TUJUH biasanya berarti barisnya terpotong saat
disalin — salin ulang, jangan ditambal.
USAGE
  exit 2
}

HOST="$1"; USER_PPP="$2"; PASS_PPP="$3"; POOL_NAS="$4"
API_USER="$5"; API_KEY="$6"; PORT_API="$7"

case "$PORT_API" in
  ''|*[!0-9]*) echo "GAGAL: port API \"$PORT_API\" bukan angka." >&2; exit 2 ;;
esac
[ "$PORT_API" -ge 1 ] && [ "$PORT_API" -le 65535 ] || {
  echo "GAGAL: port API $PORT_API di luar 1-65535." >&2; exit 2
}

# Konvensi sama dengan install-appliance.sh. Tanpa ini kegagalannya muncul di
# tengah jalan — sesudah .env ditambal — sebagai "Permission denied" pada
# berkas yang tak disebut mitra di mana pun.
[ "$(id -u)" = "0" ] || { echo "jalankan sebagai root (sudo)" >&2; exit 1; }

STACK_DIR="${STACK_DIR:-/opt/freeradius-api}"
ENV_FILE="$STACK_DIR/.env"

[ -f "$ENV_FILE" ] || {
  echo "GAGAL: $ENV_FILE tidak ada — firstboot belum jalan." >&2
  echo "Nyalakan ulang appliance, atau jalankan: systemctl start radius-appliance-firstboot" >&2
  echo >&2
  echo "Sedang MENGUJI di klona repo, bukan di appliance? Tunjuk direktorinya:" >&2
  echo "  sudo STACK_DIR=\"\$PWD\" ./appliance/radius-erp-enroll ..." >&2
  echo "(jangan jalankan firstboot.sh di mesin kerja — ia membangkitkan ulang" >&2
  echo " host key SSH mesin ini dan menandai dirinya selesai)" >&2
  exit 1
}

# Menambal baris ber-^KEY=, bukan menulis ulang berkas: .env memuat sandi DB
# unik yang dibangkitkan firstboot, dan menulis ulang berarti kehilangan
# sandi yang sudah tertanam di raddb — FreeRADIUS langsung gagal konek DB.
#
# Konvensinya SAMA dengan applyShellVarPatches di radius-manager-api: cocokkan
# ^KEY= di kolom 0, jangan indentasi, jangan ganti nama kuncinya.
tambal() {
  local kunci="$1" nilai="$2"
  if grep -q "^${kunci}=" "$ENV_FILE"; then
    sed -i -E "s|^${kunci}=.*|${kunci}=${nilai}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$kunci" "$nilai" >>"$ENV_FILE"
  fi
  grep -q "^${kunci}=${nilai}$" "$ENV_FILE" || {
    echo "GAGAL menanam ${kunci} ke $ENV_FILE" >&2
    exit 1
  }
}

echo "menanam kredensial REST ..."
tambal BASIC_AUTH_USER "$API_USER"
tambal BASIC_AUTH_PASSWORD "$API_KEY"
# PORT, bukan hanya kredensial. dst-nat di concentrator 1:1 TANPA to-ports
# (URL tiap instance NOC memuat nomor portnya sendiri dan tersimpan di
# database — menulis ulang port di router memutus 24 instance produksi), jadi
# paket mendarat di appliance pada port dst-nat. Appliance yang mendengarkan
# 8000 tak menjawab apa pun: dst-nat benar, firewall benar, tunnel naik, dan
# "URL-nya tidak bisa dibuka" tanpa satu pun galat di router maupun di sini.
tambal API_PORT "$PORT_API"
# API_KEY env dibiarkan KOSONG dengan sengaja: ERP hanya memakai Basic auth
# (internal/pkg/radiusclient — tidak ada dukungan X-API-Key sama sekali), dan
# kunci kedua yang tak dipakai siapa pun hanya memperbesar permukaan.
chmod 600 "$ENV_FILE"

# Jaringan Docker DIPINDAH dari 172.16.0.0/12 SEBELUM apa pun dimuat ulang.
# Appliance dari OVA lama memakai bawaan Docker (172.17/16, …) yang bentrok
# dengan pool NAS concentrator: gateway pool terbaca alamat lokal, REST API
# tak terjangkau dari ERP dan auth RADIUS ke NAS nyasar ke docker0 — dari
# router semuanya tampak benar (staging JKT-1, 21 Okt 2026). Volume DB aman.
DOCKER_NET="$(dirname "$(readlink -f "$0")")/radius-docker-net"
[ -x "$DOCKER_NET" ] || DOCKER_NET="$(command -v radius-docker-net || true)"
if [ -n "$DOCKER_NET" ]; then
  # LAN mitra di 172.16.0.0/12 DITOLAK sebelum apa pun diubah: ERP tak bisa
  # memindahkannya, dan kalau dibiarkan rute LAN mengalahkan rute tunnel —
  # API tak terjangkau dan auth NAS gagal tanpa satu pun galat.
  # shellcheck source=radius-docker-net
  LAN_BENTROK="$( source "$DOCKER_NET"; lan_bentrok )"
  if [ -n "$LAN_BENTROK" ]; then
    echo "GAGAL: LAN appliance ini memakai alamat di 172.16.0.0–172.31.255.255:" >&2
    echo "$LAN_BENTROK" | sed 's/^/  /' >&2
    echo "Rentang itu KHUSUS jalur VPN concentrator (pool NAS + alamat RADIUS)." >&2
    echo "Pindahkan appliance ke LAN lain (mis. 192.168.x.x atau 10.x.x.x)," >&2
    echo "atau ubah alamat LAN-nya, lalu jalankan ulang baris ini. Belum ada yang diubah." >&2
    exit 1
  fi
  echo "memeriksa jaringan Docker ..."
  STACK_DIR="$STACK_DIR" "$DOCKER_NET"
else
  echo "PERINGATAN: radius-docker-net tidak ada — jaringan Docker tidak diperiksa." >&2
  echo "  Kalau 'ip route get <gateway pool NAS>' menjawab 'local … dev lo', appliance ini" >&2
  echo "  bentrok dengan pool VPN. Lihat appliance/README.md (Jaringan Docker)." >&2
fi

# Container api membaca env saat START, jadi `up -d` saja tidak cukup kalau
# container-nya sudah jalan dengan env lama — ia tidak akan dibuat ulang hanya
# karena berkas .env berubah. --force-recreate memaksanya.
echo "memuat ulang API ..."
( cd "$STACK_DIR" && docker compose up -d --force-recreate api )

# Diverifikasi dari dalam appliance SEBELUM menyentuh VPN: kalau Basic auth
# belum berlaku, lebih baik ketahuan sekarang daripada muncul nanti sebagai
# "ERP tak bisa sinkron" yang terlihat seperti masalah jaringan.
echo -n "memastikan kredensial berlaku"
for _ in $(seq 1 15); do
  # Diuji pada PORT TERBITnya, bukan 8000: yang harus terbukti adalah port
  # yang benar-benar dituju dst-nat. Menguji 8000 akan tetap hijau pada
  # appliance yang portnya salah — persis kegagalan yang hendak ditutup.
  kode="$(curl -so /dev/null -w '%{http_code}' -m 3 \
    -u "${API_USER}:${API_KEY}" "http://127.0.0.1:${PORT_API}/api/v1/nas/" || true)"
  if [ "$kode" = "200" ]; then
    echo " OK"
    break
  fi
  echo -n "."
  sleep 2
done
if [ "${kode:-}" != "200" ]; then
  echo
  echo "GAGAL: API membalas ${kode:-tak ada jawaban} untuk kredensial itu." >&2
  echo "Jangan lanjut menyambungkan VPN — ERP akan tetap 401." >&2
  echo "Log: cd $STACK_DIR && docker compose logs --tail=50 api" >&2
  exit 1
fi

# Saudara sebelah DULU, lalu PATH. Di appliance keduanya sama-sama ada di
# /usr/local/sbin jadi tak ada bedanya; yang berbeda adalah saat skrip ini
# dijalankan langsung dari klona repo (uji coba). Tanpa ini `exec` gagal dengan
# "command not found" SESUDAH kredensial tertanam dan API sudah diverifikasi —
# berhenti di tengah, dengan pesan yang tidak menyebut apa yang kurang.
VPN_CONNECT="$(dirname "$(readlink -f "$0")")/radius-vpn-connect"
[ -x "$VPN_CONNECT" ] || VPN_CONNECT="$(command -v radius-vpn-connect || true)"
[ -n "$VPN_CONNECT" ] || {
  echo "GAGAL: radius-vpn-connect tidak ada di sebelah skrip ini maupun di PATH." >&2
  echo "Kredensial REST SUDAH tertanam dan terverifikasi — yang belum hanya VPN-nya." >&2
  echo "Pasang lalu ulangi, atau jalankan langsung:" >&2
  echo "  radius-vpn-connect $HOST $USER_PPP <sandi-ppp> $POOL_NAS" >&2
  exit 1
}

echo "menyambungkan ke VPN concentrator ..."
exec "$VPN_CONNECT" "$HOST" "$USER_PPP" "$PASS_PPP" "$POOL_NAS"
